# Koshary secrets. Copy to .env and fill in.
# .env is gitignored. These values are redacted from all logs.

# CTFd session cookie (CTFd mode)
CTFD_SESSION=

# Hack The Box CTF MCP token (htb_ctf mode)
HTB_MCP_TOKEN=

# Hack The Box CTF cookie/bearer (htb_cookie mode).
# Capture these from a logged-in, event-joined browser session (DevTools/Burp).
# Both are sent together by default (auth_mode cookie_bearer). Never commit them.
HTB_CTF_COOKIE=
HTB_CTF_BEARER=
HTB_CTF_USER_AGENT=
