{
  "ctf": {
    "name": "UTCTF",
    "base_url": "https://utctf.live",
    "flag_patterns": [
      "utflag\\{[^\\s]+\\}",
      "UTFLAG\\{[^\\s]+\\}",
      "flag\\{[^\\s]+\\}",
      "CTF\\{[^\\s]+\\}"
    ],
    "auto_submit": true,
    "max_agent_rounds": 8,
    "max_idle_rounds": 2,
    "model_timeout": 300,
    "artifact_timeout": 240,
    "command_timeout": 90,
    "parallel_workers": 3,
    "max_run_commands_per_round": 4,
    "workspace_max_files": 40,
    "workspace_max_chars_per_file": 12000,
    "include_categories": [],
    "exclude_categories": []
  },
  "routing": {
    "web": "gemini",
    "web exploitation": "gemini",
    "crypto": "codex",
    "cryptography": "codex",
    "pwn": "codex",
    "binary exploitation": "codex"
  },
  "models": {
    "gemini": {
      "runner": "bash /home/kali/Desktop/researchs/CTF-AI/runners/run_gemini.sh",
      "prompt_template": "prompts/web.txt"
    },
    "codex_crypto": {
      "runner": "bash /home/kali/Desktop/researchs/CTF-AI/runners/run_codex.sh",
      "prompt_template": "prompts/crypto.txt"
    },
    "codex_pwn": {
      "runner": "bash /home/kali/Desktop/researchs/CTF-AI/runners/run_codex.sh",
      "prompt_template": "prompts/pwn.txt"
    }
  },
  "workspace": {
    "root": "challenges",
    "state_file": "state/db.json",
    "log_dir": "state/logs"
  }
}
